    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "19.2.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "..",
      "exclude": [
        "expo-application"
      ]
    }
