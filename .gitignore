android.iml
# `android/app/` only exists if `expo prebuild` was accidentally run
# from the SDK root (the SDK is a library module — its build is at
# `android/build.gradle`, not `android/app/build.gradle`). Ignoring the
# whole tree prevents accidental commits if it gets regenerated.
android/app/
android/keystores/debug.keystore

# Cocoapods
#
example/ios/Pods

# Swift Package Manager
# Resolution lockfile is regenerated by Xcode/xcodebuild and clashes
# with pod-install's workspace touchups. Our IdsvrHaapiSdk SPM pin
# uses `exactVersion: "5.4.0"` (in podspec + Package.swift), so the
# lockfile adds no determinism we don't already have.
**/xcshareddata/swiftpm/Package.resolved
.build/

